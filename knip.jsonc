{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Scope: the Next.js app tree only. contracts/ and relayer/ are their own npm
  // trees (same split as .dependency-cruiser.js; ESLint does lint relayer/ from
  // the root since 2026-09-12 — relayer knip is a named follow-up in
  // docs/REVIEW_TIERS.md); supabase/ holds SQL, not modules. knip's Next.js
  // and next-intl plugins pick up app/**, middleware.ts and i18n/request.ts as
  // entries on their own. scripts/*.mjs are CI tooling run directly by node.
  "entry": ["scripts/*.mjs"],
  "project": ["app/**", "components/**", "hooks/**", "lib/**", "i18n/**", "content/**", "scripts/**"]
}
